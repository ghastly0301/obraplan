generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senhaHash String
  /// admin: administrador do ObraPlan, resolve os chamados de suporte.
  /// empreiteiro: usa o sistema e abre chamados.
  papel     String    @default("empreiteiro")
  criadoEm  DateTime  @default(now())
  sessoes   Sessao[]
  chamados  Chamado[]
}

model Sessao {
  token     String   @id
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
}

model Cliente {
  id        Int    @id @default(autoincrement())
  nome      String
  documento String
  telefone  String
  email     String
  obras     Obra[]
}

model Obra {
  id            Int                 @id @default(autoincrement())
  nome          String
  clienteId     Int
  cliente       Cliente             @relation(fields: [clienteId], references: [id])
  endereco      String
  dataInicio    DateTime
  prazoDias     Int
  valorContrato Float
  status        String              @default("planejada")
  servicos      Servico[]
  medicoes      Medicao[]
  diarios       Diario[]
  fotos         Foto[]
  recebimentos  Recebimento[]
  usosMaterial  MovimentoMaterial[]
}

/// Chamado de suporte do sistema: o empreiteiro relata um bug ou
/// dificuldade para o administrador do ObraPlan resolver.
model Chamado {
  id          Int       @id @default(autoincrement())
  usuarioId   Int // quem relatou
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo      String
  descricao   String
  tela        String? // onde aconteceu (ex.: Medição, Diário)
  prioridade  String    @default("media") // baixa | media | alta
  status      String    @default("aberto") // aberto | em_analise | resolvido
  resposta    String? // retorno do administrador
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?
}

model Funcionario {
  id         Int                    @id @default(autoincrement())
  nome       String
  funcao     String
  diaria     Float
  criadoEm   DateTime               @default(now())
  movimentos MovimentoFuncionario[]
}

model MovimentoFuncionario {
  id            Int         @id @default(autoincrement())
  funcionarioId Int
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  data          DateTime
  tipo          String // trabalho | pagamento
  dias          Float? // apenas trabalho
  valor         Float // trabalho: dias x diária (na época) | pagamento: valor pago
  descricao     String?
}

model Material {
  id         Int                 @id @default(autoincrement())
  nome       String
  unidade    String
  movimentos MovimentoMaterial[]
}

model MovimentoMaterial {
  id            Int      @id @default(autoincrement())
  materialId    Int
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  obraId        Int? // apenas uso: em qual obra foi usado
  obra          Obra?    @relation(fields: [obraId], references: [id], onDelete: SetNull)
  data          DateTime
  tipo          String // compra | uso
  quantidade    Float
  precoUnitario Float? // apenas compra
  descricao     String? // fornecedor, local de uso etc.
}

model Recebimento {
  id        Int      @id @default(autoincrement())
  obraId    Int
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  data      DateTime
  valor     Float
  descricao String?
}

model Servico {
  id            Int           @id @default(autoincrement())
  obraId        Int
  obra          Obra          @relation(fields: [obraId], references: [id], onDelete: Cascade)
  codigo        String
  descricao     String
  unidade       String
  quantidade    Float
  precoUnitario Float
  itens         MedicaoItem[]
  fotos         Foto[]
}

model Medicao {
  id            Int           @id @default(autoincrement())
  obraId        Int
  obra          Obra          @relation(fields: [obraId], references: [id], onDelete: Cascade)
  numero        Int
  periodoInicio DateTime
  periodoFim    DateTime
  status        String        @default("rascunho")
  observacoes   String?
  itens         MedicaoItem[]

  @@unique([obraId, numero])
}

model MedicaoItem {
  id                  Int     @id @default(autoincrement())
  medicaoId           Int
  medicao             Medicao @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  servicoId           Int
  servico             Servico @relation(fields: [servicoId], references: [id])
  quantidadeExecutada Float

  @@unique([medicaoId, servicoId])
}

model Diario {
  id          Int      @id @default(autoincrement())
  obraId      Int
  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  data        DateTime
  climaManha  String
  climaTarde  String
  efetivo     Int
  atividades  String
  ocorrencias String?

  @@unique([obraId, data])
}

model Foto {
  id             Int      @id @default(autoincrement())
  obraId         Int
  obra           Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  servicoId      Int?
  servico        Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  data           DateTime
  legenda        String?
  caminhoArquivo String
  criadoEm       DateTime @default(now())
}
