# Copie para .env. O arquivo .env não vai para o git.
#
# Desenvolvimento local com Postgres na máquina:
DATABASE_URL="postgresql://postgres@localhost:5432/obraplan"
#
# Em produção (Vercel) estas variáveis são configuradas no painel do projeto,
# não neste arquivo:
#   DATABASE_URL          string de conexão do Postgres
#   BLOB_READ_WRITE_TOKEN token do Vercel Blob, onde ficam as fotos
